NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Leave a URL empty to run the app without that service.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bookmyshow
REDIS_URL=redis://localhost:6379

# Docker host ports (docker compose only)
MONGO_PORT=27017
REDIS_PORT=6379
